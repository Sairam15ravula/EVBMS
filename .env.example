# ==============================================================================
# EV Battery Intelligence Platform - Environment Configuration Example
# Copy this file to .env and configure values as needed.
# ==============================================================================

# AI / LLM Configuration
# Optional: If omitted, the AI Assistant degrades gracefully to deterministic physics & SHAP rule-based analysis
GEMINI_API_KEY=""

# Application Host & URLs
APP_URL="http://localhost:3000"
PORT=3000
BACKEND_PORT=8000
VITE_BACKEND_URL="http://localhost:8000"
VITE_WS_URL="ws://localhost:3000"

# Database Configuration
# Defaults to local SQLite (sqlite+aiosqlite:///backend/ev_bms.db) for zero-config setup
# For PostgreSQL: postgresql+asyncpg://postgres:password@localhost:5432/ev_battery_platform
DATABASE_URL="sqlite+aiosqlite:///backend/ev_bms.db"

# Security & Authentication
# Change in production!
SECRET_KEY="dev-secret-key-change-in-production-only"
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM="HS256"

# Environment Mode
ENVIRONMENT="development"
